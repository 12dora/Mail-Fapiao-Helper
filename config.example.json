{
  "_readme": "首次启动会把本文件复制成真实配置，因此 imap.host / imap.user / imap.pass 必须保持为空字符串：空值表示「尚未配置」，请在应用设置里填写自己的邮箱服务器、账号与授权码（不要在这里写示例值或 *** 占位符）。JSON 不支持注释，本字段仅作说明，程序会忽略它。",
  "schemaVersion": 3,
  "imap": {
    "host": "",
    "port": 993,
    "user": "",
    "pass": "",
    "tls": true,
    "mailbox": []
  },
  "filter": {
    "keywords": ["发票"],
    "matchSubject": true,
    "matchBody": true,
    "sinceDays": 30,
    "since": null,
    "until": null
  },
  "paths": {
    "samples": "./samples/raw",
    "invoices": "./invoices",
    "pending": "./pending"
  },
  "output": {
    "csv": "./invoices.csv"
  },
  "rename": {
    "avoidConflictBeforeOcr": true,
    "rule": "{seller}-{amount}.pdf",
    "fallback": "{date}-{messageId}.pdf",
    "applyAfterOcr": false,
    "organizeByType": false,
    "typeDirRule": "{documentType}",
    "organizedDir": "./invoices/organized"
  },
  "ocr": {
    "enabled": true,
    "provider": "efapiao",
    "binaryPath": "auto",
    "ocrMode": "auto",
    "executionMode": "auto",
    "serviceUrl": "",
    "serviceHost": "127.0.0.1",
    "servicePort": 8000,
    "serviceWorkers": 1,
    "serviceStartupMs": 30000,
    "batchSize": 16,
    "timeoutMs": 120000,
    "resultsCsv": "./invoices/ocr/ocr-results.csv",
    "credentials": {
      "apiKey": "",
      "ocrVendor": "",
      "cnocrModelProfile": "invoice-lite",
      "secretKey": "",
      "tencentSecretId": "",
      "tencentSecretKey": "",
      "tencentRegion": "ap-shanghai"
    }
  },
  "playwright": {
    "headless": true,
    "timeoutMs": 30000
  },
  "network": {
    "retries": 3,
    "retryDelayMs": 1000,
    "timeoutMs": 30000
  }
}
