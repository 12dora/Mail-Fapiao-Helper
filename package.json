{
  "name": "mail-fapiao-helper",
  "version": "0.0.7",
  "description": "从邮箱抓取发票邮件、自动下载并归档 PDF",
  "private": true,
  "type": "module",
  "bin": {
    "mfh": "./dist/index.js"
  },
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p . && node -e \"require('node:fs').writeFileSync('dist/buildInfo.js','/** @generated by npm run build (dev tree; pack/dist rewrites flag) */\\nexport const production = false;\\nexport const channel = \\\"development\\\";\\n')\"",
    "pack": "npm run build && node -e \"require('node:fs').writeFileSync('dist/buildInfo.js','/** @generated for release packaging */\\nexport const production = true;\\nexport const channel = \\\"release\\\";\\n')\" && node scripts/build-release.mjs --dir",
    "dist": "npm run build && node -e \"require('node:fs').writeFileSync('dist/buildInfo.js','/** @generated for release packaging */\\nexport const production = true;\\nexport const channel = \\\"release\\\";\\n')\" && node scripts/build-release.mjs",
    "dist:mac": "npm run build && node -e \"require('node:fs').writeFileSync('dist/buildInfo.js','/** @generated for release packaging */\\nexport const production = true;\\nexport const channel = \\\"release\\\";\\n')\" && node scripts/build-release.mjs --mac",
    "dist:win": "npm run build && node -e \"require('node:fs').writeFileSync('dist/buildInfo.js','/** @generated for release packaging */\\nexport const production = true;\\nexport const channel = \\\"release\\\";\\n')\" && node scripts/build-release.mjs --win",
    "verify:artifacts": "node scripts/verify-release-artifacts.mjs",
    "electron": "npm run build && electron .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "pretest:cli": "node scripts/check-test-prereqs.mjs cli",
    "test:cli": "node gui-design/tests/cli-regression.mjs && node gui-design/tests/cli-integration.mjs",
    "pretest:electron": "node scripts/check-test-prereqs.mjs electron",
    "test:electron": "node gui-design/tests/electron-smoke.mjs && node gui-design/tests/electron-ipc-fixture.mjs",
    "pretest:browser": "node scripts/check-test-prereqs.mjs browser",
    "test:browser": "node gui-design/tests/e2e-fixes.mjs && node gui-design/tests/e2e.mjs",
    "test:core": "npm run build && npm run typecheck && npm run test:cli && npm run test:electron",
    "test": "npm run test:core",
    "test:all": "npm run test:core && npm run test:browser",
    "screenshots": "node scripts/take-screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.41",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "html-to-text": "10.0.1",
    "linkify-it": "^5.0.2",
    "nodemailer": "^9.0.1"
  },
  "build": {
    "appId": "com.mailfapiao.helper",
    "productName": "发票助手",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/electron/devFakeBackend.js",
      "!dist/electron/devFakeBackend.js.map",
      "!dist/ocr/mockProvider.js",
      "!dist/ocr/mockProvider.js.map",
      "electron/**/*",
      "gui-design/**/*",
      "!gui-design/tests/**",
      "icon/**/*",
      "config.example.json",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/vendor/efapiao/0.1.3/darwin-arm64/efapiao"
      ],
      "extraResources": [
        {
          "from": "vendor/efapiao/0.1.3/darwin-arm64",
          "to": "vendor/efapiao/0.1.3/darwin-arm64"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icon/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "extraResources": [
        {
          "from": "vendor/efapiao/0.1.3/windows-x86_64",
          "to": "vendor/efapiao/0.1.3/windows-x86_64"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}-${arch}.${ext}",
      "installerIcon": "icon/icon.ico",
      "uninstallerIcon": "icon/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
